<script>
import { supabase } from '../lib/supabase';
import { loadMenuHtml } from '../lib/menu';
import { loadGalleryHtml } from '../lib/galeri';

(() => {
  const WA = '6285728958582';
  const waLink = (text) => `https://wa.me/${WA}?text=${encodeURIComponent(text)}`;

  // Open/closed status in WIB
  const hour = Number(new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Jakarta' }).format(new Date()));
  const isOpen = hour >= 9 && hour < 19;
  document.getElementById('status').classList.toggle('open', isOpen);
  document.getElementById('statusText').textContent = isOpen
    ? 'Buka sekarang · sampai 19.00'
    : 'Sedang tutup · buka lagi jam 09.00';

  document.getElementById('yr').textContent = new Date().getFullYear();

  // Header border + mobile dock after scrolling past hero
  const head = document.getElementById('head');
  const dock = document.getElementById('dock');
  const booking = document.getElementById('booking');
  let bookingVisible = false;
  new IntersectionObserver(([e]) => { bookingVisible = e.isIntersecting; onScroll(); }, { threshold: 0.15 }).observe(booking);
  function onScroll() {
    const y = window.scrollY;
    head.classList.toggle('scrolled', y > 8);
    dock.classList.toggle('show', y > 520 && !bookingVisible);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Service rows -> WhatsApp with prefilled question
  const wireAsk = (root) => root.querySelectorAll('.menu-item[data-ask]').forEach((a) => {
    a.href = waLink(`Assalamualaikum kak, mau tanya harga ${a.dataset.ask} di An-Nisa Muslimah Salon.`);
    a.target = '_blank';
    a.rel = 'noopener';
  });
  wireAsk(document);

  // Scroll reveal: sekali saja, elemen yang masuk bersamaan diberi jeda 60ms
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const io = new IntersectionObserver((entries) => {
    let n = 0;
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target;
      el.style.transitionDelay = `${Math.min(n++, 5) * 60}ms`;
      el.classList.add('in');
      el.addEventListener('transitionend', () => { el.style.transitionDelay = ''; }, { once: true });
      io.unobserve(el);
    });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  // Daftar layanan: nama, harga, dan deskripsi ikut katalog di dashboard (tab Harga > Layanan).
  // Layanan berharga contoh tampil "Tanya harga". HTML di atas jadi cadangan kalau fetch gagal.
  (async () => {
    const menu = document.querySelector('.menu');
    const html = await loadMenuHtml().catch(() => null);
    if (!menu || !html) return;
    const seen = [...menu.children].map((g) => g.classList.contains('in'));
    menu.innerHTML = html;
    [...menu.children].forEach((g, i) => {
      // grup yang sudah sempat muncul tidak dianimasikan ulang (hindari berkedip)
      if (seen[i]) { g.classList.add('in'); return; }
      g.setAttribute('data-reveal', '');
      io.observe(g);
    });
    wireAsk(menu);
  })();

  // Teaser produk: jumlah & harga terendah ikut katalog (aktif/nonaktif & harga dari tab Harga di dashboard).
  // Teks bawaan di HTML tetap jadi cadangan kalau fetch gagal.
  (async () => {
    if (!supabase) return;
    const { data, error } = await supabase
      .from('catalog_items').select('price,web_price')
      .eq('category_id', 'produk').eq('active', true).not('price', 'is', null);
    if (error || !data?.length) return;
    const min = Math.min(...data.map((r) => (r.web_price ?? r.price) as number));
    document.getElementById('shopFrom')!.textContent = 'Rp' + min.toLocaleString('id-ID');
    document.getElementById('shopCount')!.textContent = String(data.length);
  })();

  // Galeri: filter + lightbox. Dipanggil lagi setelah grid diganti isi dari database.
  const lb = document.getElementById('lb');
  const lbImg = document.getElementById('lbImg');
  const lbCap = document.getElementById('lbCap');
  let shots = [], current = [], idx = 0;
  const catsOf = (s) => s.dataset.c.split('|');
  function show(i) {
    idx = (i + current.length) % current.length;
    const img = current[idx].querySelector('img');
    lbImg.src = img.dataset.full;
    lbImg.alt = img.alt;
    lbCap.textContent = current[idx].querySelector('figcaption b').textContent + ` · ${idx + 1}/${current.length}`;
  }
  function bindGallery() {
    const tabs = [...document.querySelectorAll('#hasil .tab')];
    shots = [...document.querySelectorAll('#grid .shot')];
    tabs.forEach((t) => {
      const f = t.dataset.f;
      const n = f === 'all' ? shots.length : shots.filter((s) => catsOf(s).includes(f)).length;
      t.insertAdjacentHTML('beforeend', `<span class="n">${n}</span>`);
      t.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-pressed', x === t));
        shots.forEach((s) => {
          // lepas dari scroll reveal supaya tidak bentrok dengan animasi filter
          io.unobserve(s);
          s.removeAttribute('data-reveal');
          s.hidden = !(f === 'all' || catsOf(s).includes(f));
        });
        // foto yang tampil masuk lagi dengan stagger tipis (transform + opacity, WAAPI)
        shots.filter((s) => !s.hidden).forEach((s, i) => {
          s.animate(
            [{ opacity: 0, transform: reduceMotion.matches ? 'none' : 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
            { duration: 260, delay: Math.min(i, 8) * 30, easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fill: 'backwards' }
          );
        });
      });
    });
    shots.forEach((s) => s.querySelector('button').addEventListener('click', () => {
      current = shots.filter((x) => !x.hidden);
      show(current.indexOf(s));
      lb.showModal();
    }));
  }
  bindGallery();

  // Isi galeri ikut dashboard (/kasir > Galeri). HTML statis di atas jadi cadangan kalau fetch gagal.
  (async () => {
    const g = await loadGalleryHtml().catch(() => null);
    if (!g) return;
    if (!g.count) { document.getElementById('hasil').hidden = true; return; }
    document.querySelector('#hasil .tabs').innerHTML = g.tabs;
    document.getElementById('grid').innerHTML = g.grid;
    document.querySelectorAll('#grid [data-reveal]').forEach((el) => io.observe(el));
    bindGallery();
  })();

  document.getElementById('lbPrev').onclick = () => show(idx - 1);
  document.getElementById('lbNext').onclick = () => show(idx + 1);
  document.getElementById('lbClose').onclick = () => lb.close();
  lb.addEventListener('click', (e) => { if (e.target.classList.contains('lb-stage')) lb.close(); });
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });

  // Booking form -> WhatsApp
  const tgl = document.getElementById('tgl');
  const today = new Date();
  tgl.min = new Date(today.getTime() - today.getTimezoneOffset() * 60000).toISOString().slice(0, 10);

  document.getElementById('form').addEventListener('submit', (e) => {
    e.preventDefault();
    const nama = document.getElementById('nama');
    if (!nama.value.trim()) { nama.focus(); nama.placeholder = 'Isi nama dulu ya'; return; }
    const layanan = [...document.querySelectorAll('#chips input:checked')].map((i) => i.value);
    const jam = document.getElementById('jam').value;
    const catatan = document.getElementById('catatan').value.trim();
    let tanggal = '';
    if (tgl.value) {
      const [y, m, d] = tgl.value.split('-').map(Number);
      tanggal = new Date(y, m - 1, d).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long' });
    }
    const lines = [
      'Assalamualaikum kak, saya mau booking di An-Nisa Muslimah Salon.',
      '',
      `Nama: ${nama.value.trim()}`,
      `Layanan: ${layanan.length ? layanan.join(', ') : 'belum tahu, mau konsultasi dulu'}`,
    ];
    if (tanggal || jam) lines.push(`Waktu: ${[tanggal, jam && 'jam ' + jam].filter(Boolean).join(', ')}`);
    if (catatan) lines.push(`Catatan: ${catatan}`);
    window.open(waLink(lines.join('\n')), '_blank', 'noopener');
  });
})();
</script>
</Base>
