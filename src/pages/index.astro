---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/site.css';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  "name": "An-Nisa Muslimah Salon",
  "telephone": "+6285728958582",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Jl. Teuku Umar No.58, Debong Tengah",
    "addressLocality": "Tegal Selatan, Kota Tegal",
    "addressRegion": "Jawa Tengah",
    "postalCode": "52192",
    "addressCountry": "ID"
  },
  "openingHoursSpecification": [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "09:00",
    "closes": "19:00"
  }],
  "hasMap": "https://maps.app.goo.gl/zMgAMAsnqgPoogeH6"
};
---
<Base
  title="An-Nisa Muslimah Salon Tegal · Salon Khusus Perempuan"
  description="Salon khusus muslimah di Jl. Teuku Umar No.58, Tegal. Smoothing, coloring, potong rambut, facial, lulur, nail art, dan spa kids. Terapis perempuan, ruang tertutup, buka setiap hari 09.00–19.00."
  ogTitle="An-Nisa Muslimah Salon Tegal"
  ogDescription="Salon khusus perempuan di Tegal. Lepas hijab tanpa was-was."
  jsonLd={jsonLd}
>
<script is:inline slot="head">if("IntersectionObserver" in window)document.documentElement.classList.add("js")</script>
<SiteHeader home />

<main id="top">

<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <p class="status" id="status"><span class="dot"></span><span id="statusText">Buka setiap hari, 09.00–19.00</span></p>
    <div class="hero-grid">
      <h1>Lepas hijab<br>tanpa <span class="nowrap">was-was.</span></h1>
      <div>
        <p class="lead">Salon khusus muslimah di Jl. Teuku Umar 58, Tegal. <strong>Terapisnya perempuan, ruangannya tertutup.</strong> Mau smoothing, ganti warna rambut, facial, atau creambath, semuanya bisa di sini.</p>
        <div class="hero-ctas">
          <a class="btn btn-green" href="#booking">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.62 1.44 5.13L2 22l5.13-1.55a9.85 9.85 0 0 0 4.9 1.31h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2z"/></svg>
            Booking lewat WhatsApp
          </a>
          <a class="link-arrow" href="#hasil">Lihat hasil kami ↓</a>
        </div>
      </div>
    </div>
  </div>

  <div class="rail" aria-label="Contoh hasil">
    <figure class="shot">
      <img src="/assets/foto/potong-layer-sm.webp" alt="Rambut hitam sebahu dengan potongan layer dan poni tipis" width="520" height="693" fetchpriority="high">
      <figcaption><b>Potong layer</b><span>sebahu</span></figcaption>
    </figure>
    <figure class="shot">
      <img src="/assets/foto/ombre-madu-sm.webp" alt="Rambut bob dengan ombre warna madu" width="520" height="693">
      <figcaption><b>Ombre</b><span>madu</span></figcaption>
    </figure>
    <figure class="shot">
      <img src="/assets/foto/smoothing-panjang-sm.webp" alt="Rambut panjang lurus mengkilap hasil smoothing" width="520" height="693">
      <figcaption><b>Smoothing</b><span>panjang</span></figcaption>
    </figure>
    <figure class="shot">
      <img src="/assets/foto/highlight-sm.webp" alt="Rambut sebahu dengan highlight pirang" width="520" height="693" loading="lazy">
      <figcaption><b>Highlight</b><span>pirang</span></figcaption>
    </figure>
    <figure class="shot">
      <img src="/assets/foto/copper-belakang-sm.webp" alt="Rambut panjang lurus warna tembaga" width="520" height="693" loading="lazy">
      <figcaption><b>Coloring</b><span>tembaga</span></figcaption>
    </figure>
  </div>
</section>

<!-- HASIL -->
<section class="section" id="hasil">
  <div class="wrap">
    <div class="sec-head split" data-reveal>
      <div>
        <p class="kicker">Hasil</p>
        <h2 class="h2">Difoto langsung<br>di kursi salon.</h2>
      </div>
      <p class="sub">Ini pelanggan kami sendiri, bukan foto katalog. Ketuk foto untuk lihat lebih besar.</p>
    </div>

    <div class="tabs" role="group" aria-label="Filter foto">
      <button class="tab" data-f="all" aria-pressed="true">Semua</button>
      <button class="tab" data-f="smoothing" aria-pressed="false">Smoothing</button>
      <button class="tab" data-f="warna" aria-pressed="false">Warna</button>
      <button class="tab" data-f="potong" aria-pressed="false">Potong</button>
      <button class="tab" data-f="alis" aria-pressed="false">Alis</button>
      <button class="tab" data-f="kuku" aria-pressed="false">Kuku</button>
      <button class="tab" data-f="anak" aria-pressed="false">Spa kids</button>
    </div>

    <div class="grid" id="grid">
      <figure class="shot" data-reveal data-c="warna|potong"><button type="button"><img loading="lazy" src="/assets/foto/silver-bob-sm.webp" data-full="/assets/foto/silver-bob.webp" alt="Potongan bob pendek warna silver ash" width="520" height="693"></button><figcaption><b>Bob silver ash</b><span>warna + potong</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="smoothing"><button type="button"><img loading="lazy" src="/assets/foto/smoothing-bob-sm.webp" data-full="/assets/foto/smoothing-bob.webp" alt="Rambut bob hitam lurus mengkilap hasil smoothing" width="520" height="693"></button><figcaption><b>Smoothing</b><span>bob</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna"><button type="button"><img loading="lazy" src="/assets/foto/copper-panjang-sm.webp" data-full="/assets/foto/copper-panjang.webp" alt="Rambut panjang warna tembaga mengkilap" width="520" height="693"></button><figcaption><b>Coloring</b><span>tembaga</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="alis"><button type="button"><img loading="lazy" src="/assets/foto/alis-2-sm.webp" data-full="/assets/foto/alis-2.webp" alt="Alis yang sudah dirapikan dan dipertegas" width="520" height="693"></button><figcaption><b>Eyebrow</b><span>rapikan alis</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna|potong"><button type="button"><img loading="lazy" src="/assets/foto/ombre-bob-sm.webp" data-full="/assets/foto/ombre-bob.webp" alt="Rambut bob ombre hitam ke pirang tampak belakang" width="520" height="693"></button><figcaption><b>Ombre bob</b><span>tampak belakang</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="smoothing"><button type="button"><img loading="lazy" src="/assets/foto/smoothing-hitam-sm.webp" data-full="/assets/foto/smoothing-hitam.webp" alt="Rambut hitam lurus sebahu hasil smoothing" width="520" height="693"></button><figcaption><b>Smoothing</b><span>hitam natural</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="kuku"><button type="button"><img loading="lazy" src="/assets/foto/kuku-marun-sm.webp" data-full="/assets/foto/kuku-marun.webp" alt="Kuku dicat warna merah marun" width="520" height="693"></button><figcaption><b>Manicure</b><span>marun</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna"><button type="button"><img loading="lazy" src="/assets/foto/highlight-sm.webp" data-full="/assets/foto/highlight.webp" alt="Rambut dengan highlight pirang dari samping" width="520" height="693"></button><figcaption><b>Highlight</b><span>pirang</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="anak"><button type="button"><img loading="lazy" src="/assets/foto/spa-kids-sm.webp" data-full="/assets/foto/spa-kids.webp" alt="Kolase spa kids: anak sedang dipijat dan di-scrub, harga 65 ribu" width="520" height="904"></button><figcaption><b>Spa kids</b><span>massage + scrub</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna|potong"><button type="button"><img loading="lazy" src="/assets/foto/ombre-samping-sm.webp" data-full="/assets/foto/ombre-samping.webp" alt="Ombre bob dengan poni samping" width="520" height="693"></button><figcaption><b>Ombre bob</b><span>poni samping</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="smoothing"><button type="button"><img loading="lazy" src="/assets/foto/treatment-hitam-sm.webp" data-full="/assets/foto/treatment-hitam.webp" alt="Rambut hitam panjang lurus setelah treatment" width="520" height="693"></button><figcaption><b>Smoothing</b><span>panjang</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="alis"><button type="button"><img loading="lazy" src="/assets/foto/alis-1-sm.webp" data-full="/assets/foto/alis-1.webp" alt="Close-up alis setelah dirapikan" width="520" height="770"></button><figcaption><b>Eyebrow</b><span>close-up</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna"><button type="button"><img loading="lazy" src="/assets/foto/copper-belakang-sm.webp" data-full="/assets/foto/copper-belakang.webp" alt="Rambut panjang warna tembaga tampak belakang" width="520" height="693"></button><figcaption><b>Coloring</b><span>tembaga</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="warna|potong"><button type="button"><img loading="lazy" src="/assets/foto/ombre-madu-sm.webp" data-full="/assets/foto/ombre-madu.webp" alt="Ombre bob warna madu" width="520" height="693"></button><figcaption><b>Ombre</b><span>madu</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="potong"><button type="button"><img loading="lazy" src="/assets/foto/potong-layer-sm.webp" data-full="/assets/foto/potong-layer.webp" alt="Potongan layer sebahu dengan poni tipis" width="520" height="693"></button><figcaption><b>Potong layer</b><span>sebahu</span></figcaption></figure>
      <figure class="shot" data-reveal data-c="smoothing"><button type="button"><img loading="lazy" src="/assets/foto/smoothing-panjang-sm.webp" data-full="/assets/foto/smoothing-panjang.webp" alt="Rambut panjang lurus hasil smoothing" width="520" height="693"></button><figcaption><b>Smoothing</b><span>panjang</span></figcaption></figure>
    </div>
  </div>
</section>

<!-- INFO -->
<section class="section info" aria-labelledby="info-title">
  <div class="wrap">
    <p class="kicker" data-reveal>Sebelum datang</p>
    <h2 class="h2" id="info-title" data-reveal>Empat hal yang sering<br>ditanyakan.</h2>
    <div class="info-list">
      <div class="info-item" data-reveal>
        <h3>Semua perempuan.</h3>
        <p>Yang melayani terapis perempuan, yang datang juga sesama perempuan.</p>
      </div>
      <div class="info-item" data-reveal>
        <h3>Ruangan tertutup.</h3>
        <p>Hijab boleh dilepas dari awal sampai selesai. Ruang perawatan tidak menghadap jalan.</p>
      </div>
      <div class="info-item" data-reveal>
        <h3>Boleh bawa anak.</h3>
        <p>Si kecil bisa ikut spa kids: body massage dan scrub, Rp65 ribu.</p>
      </div>
      <div class="info-item" data-reveal>
        <h3>Buka tiap hari.</h3>
        <p>Jam 09.00 sampai 19.00, termasuk Sabtu dan Minggu.</p>
      </div>
    </div>
  </div>
</section>

<!-- LAYANAN -->
<section class="section" id="layanan">
  <div class="wrap">
    <div class="sec-head split" data-reveal>
      <div>
        <p class="kicker">Layanan</p>
        <h2 class="h2">Menu perawatan.</h2>
      </div>
      <p class="sub">Harga perawatan rambut tergantung panjang dan kondisinya. Ketuk layanan yang kamu mau, WhatsApp terbuka dengan pertanyaannya sudah tertulis.</p>
    </div>

    <div class="menu">
      <div class="menu-group" data-reveal>
        <div class="menu-cat"><h3>Rambut</h3><p>Dari rapikan ujung sampai ganti warna.</p></div>
        <ul class="menu-list">
          <li><a class="menu-item" data-ask="Smoothing" href="https://wa.me/6285728958582"><span class="m-name">Smoothing</span><span class="m-price">Tanya harga →</span><span class="m-desc">Rambut jadi lurus, jatuh, dan gampang diatur.</span></a></li>
          <li><a class="menu-item" data-ask="Hair coloring" href="https://wa.me/6285728958582"><span class="m-name">Coloring</span><span class="m-price">Tanya harga →</span><span class="m-desc">Warna penuh, highlight, atau ombre.</span></a></li>
          <li><a class="menu-item" data-ask="Bleaching" href="https://wa.me/6285728958582"><span class="m-name">Bleaching &amp; toning</span><span class="m-price">Tanya harga →</span><span class="m-desc">Dasar untuk warna terang seperti pirang, madu, atau ash.</span></a></li>
          <li><a class="menu-item" data-ask="Potong rambut" href="https://wa.me/6285728958582"><span class="m-name">Potong rambut</span><span class="m-price">Tanya harga →</span><span class="m-desc">Layer, bob, poni, atau sekadar rapikan ujung.</span></a></li>
          <li><a class="menu-item" data-ask="Creambath" href="https://wa.me/6285728958582"><span class="m-name">Creambath</span><span class="m-price">Tanya harga →</span><span class="m-desc">Krim rambut plus pijat kepala dan pundak.</span></a></li>
          <li><a class="menu-item" data-ask="Hair spa" href="https://wa.me/6285728958582"><span class="m-name">Hair spa</span><span class="m-price">Tanya harga →</span><span class="m-desc">Untuk rambut kering, kusam, atau habis diwarnai.</span></a></li>
        </ul>
      </div>

      <div class="menu-group" data-reveal>
        <div class="menu-cat"><h3>Wajah</h3><p>Pilih merek produk yang biasa kamu pakai.</p></div>
        <div>
          <ul class="menu-list">
            <li><a class="menu-item" data-ask="Facial reguler" href="https://wa.me/6285728958582"><span class="m-name">Facial reguler</span><span class="m-price fixed">55rb</span><span class="m-desc">Membersihkan komedo dan sisa makeup, ditutup masker.</span></a></li>
            <li><a class="menu-item" data-ask="Facial detox" href="https://wa.me/6285728958582"><span class="m-name">Facial detox</span><span class="m-price fixed">150rb</span><span class="m-desc">Pembersihan mendalam dengan alat detox. Untuk komedo, jerawat, minyak berlebih, dan pori-pori.</span></a></li>
            <li><a class="menu-item" data-ask="Facial Glow Beauty by Gbee" href="https://wa.me/6285728958582"><span class="m-name">Facial Glow Beauty <span class="by">by Gbee</span></span><span class="m-price fixed">95rb</span><span class="m-desc">Untuk kulit wajah yang terlihat kusam.</span></a></li>
            <li><a class="menu-item" data-ask="Eyebrow" href="https://wa.me/6285728958582"><span class="m-name">Eyebrow</span><span class="m-price">Tanya harga →</span><span class="m-desc">Alis dibentuk, dirapikan, dan dipertegas.</span></a></li>
          </ul>

          <div class="brand-table">
            <p class="bt-title">Facial &amp; totok wajah per merek</p>
            <div class="bt-scroll">
              <table>
                <thead>
                  <tr><th scope="col">Merek</th><th scope="col">Facial basic</th><th scope="col">Brightening · Anti aging · Collagen · Acne</th><th scope="col">Totok wajah</th></tr>
                </thead>
                <tbody>
                  <tr><th scope="row">Sariayu</th><td>65rb</td><td>80rb</td><td>50rb</td></tr>
                  <tr><th scope="row">Wardah</th><td>75rb</td><td>90rb</td><td>55rb</td></tr>
                  <tr><th scope="row">La Tulipe</th><td>75rb</td><td>90rb</td><td>55rb</td></tr>
                  <tr><th scope="row">Biokos</th><td>85rb</td><td>95rb</td><td>60rb</td></tr>
                  <tr><th scope="row">Ristra</th><td>85rb</td><td>95rb</td><td>60rb</td></tr>
                  <tr><th scope="row">Gbee</th><td>–</td><td>–</td><td>60rb</td></tr>
                </tbody>
              </table>
            </div>
            <p class="bt-note">Brightening, anti aging, collagen, dan acne harganya sama di tiap merek.</p>
          </div>
        </div>
      </div>

      <div class="menu-group" data-reveal>
        <div class="menu-cat"><h3>Badan</h3><p>Di ruang spa terpisah.</p></div>
        <ul class="menu-list">
          <li><a class="menu-item" data-ask="Lulur" href="https://wa.me/6285728958582"><span class="m-name">Lulur</span><span class="m-price">Tanya harga →</span><span class="m-desc">Mengangkat kulit mati, kulit lebih halus.</span></a></li>
          <li><a class="menu-item" data-ask="Body massage" href="https://wa.me/6285728958582"><span class="m-name">Body massage</span><span class="m-price">Tanya harga →</span><span class="m-desc">Pijat seluruh badan untuk yang pegal-pegal.</span></a></li>
          <li><a class="menu-item" data-ask="Body whitening" href="https://wa.me/6285728958582"><span class="m-name">Whitening</span><span class="m-price">Tanya harga →</span><span class="m-desc">Perawatan untuk mencerahkan kulit badan.</span></a></li>
        </ul>
      </div>

      <div class="menu-group" data-reveal>
        <div class="menu-cat"><h3>Kuku</h3></div>
        <ul class="menu-list">
          <li><a class="menu-item" data-ask="Manicure" href="https://wa.me/6285728958582"><span class="m-name">Manicure</span><span class="m-price">Tanya harga →</span><span class="m-desc">Kuku tangan dibersihkan, dibentuk, dan diwarnai.</span></a></li>
          <li><a class="menu-item" data-ask="Pedicure" href="https://wa.me/6285728958582"><span class="m-name">Pedicure</span><span class="m-price">Tanya harga →</span><span class="m-desc">Sama, untuk kuku kaki.</span></a></li>
          <li><a class="menu-item" data-ask="Nail art" href="https://wa.me/6285728958582"><span class="m-name">Nail art</span><span class="m-price">Tanya harga →</span><span class="m-desc">Bawa contoh motif yang kamu suka.</span></a></li>
        </ul>
      </div>

      <div class="menu-group" data-reveal>
        <div class="menu-cat"><h3>Anak</h3></div>
        <ul class="menu-list">
          <li><a class="menu-item" data-ask="Spa kids" href="https://wa.me/6285728958582"><span class="m-name">Spa kids</span><span class="m-price fixed">Rp65.000</span><span class="m-desc">Body massage dan scrub khusus anak. Bisa sambil ibunya perawatan.</span></a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- PRODUK -->
<section class="section shop" id="produk">
  <div class="wrap shop-grid">
    <div data-reveal>
      <p class="kicker">Produk</p>
      <h2 class="h2">Bawa pulang<br>skincare-nya.</h2>
      <p class="sub">Kami juga jual skincare Gbee Glow Beauty, seri yang sama dengan Facial Glow Beauty di salon. Ada day &amp; night cream, facial wash, toner, jelly face, sampai produk untuk pria.</p>
      <p class="from">Mulai dari <b id="shopFrom">Rp40.000</b> · <span id="shopCount">22</span> produk</p>
      <a class="btn btn-green" href="/produk">Lihat semua produk →</a>
    </div>
    <div class="shop-imgs" data-reveal>
      <img loading="lazy" src="/assets/produk/krim-pink-gold.webp" alt="Day Cream Gbee" width="142" height="142">
      <img loading="lazy" src="/assets/produk/krim-set.webp" alt="Night Cream Gbee seri Gold dan Pink" width="142" height="142">
      <img loading="lazy" src="/assets/produk/rice-jelly.webp" alt="Rice Jelly Face Gbee" width="142" height="142">
    </div>
  </div>
</section>

<!-- TEMPAT -->
<section class="section place" id="tempat">
  <div class="wrap place-grid">
    <div data-reveal>
      <p class="kicker">Tempat</p>
      <h2 class="h2">Begini suasananya.</h2>
      <p class="sub">Buat yang baru pertama kali datang: area depan untuk rambut dan wajah, dengan meja rias dan cermin besar. Lulur dan massage di ruang spa yang terpisah.</p>
      <ul class="facts">
        <li><span>Alamat</span><span>Jl. Teuku Umar 58, Tegal Sel.</span></li>
        <li><span>Jam buka</span><span>Setiap hari, 09.00–19.00</span></li>
        <li><span>Khusus</span><span>Perempuan &amp; anak</span></li>
      </ul>
    </div>
    <div class="place-photos">
      <figure data-reveal>
        <img class="a" loading="lazy" src="/assets/foto/salon-interior-sm.webp" alt="Area depan salon: meja rias panjang, cermin, kursi, dan lantai keramik putih" width="520" height="693">
        <figcaption>Area rambut &amp; wajah</figcaption>
      </figure>
      <figure data-reveal>
        <img class="b" loading="lazy" src="/assets/foto/ruang-spa-sm.webp" alt="Ruang spa dengan dua kasur pijat dan dinding bata ekspos" width="520" height="693">
        <figcaption>Ruang spa</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- BOOKING -->
<section class="section" id="booking">
  <div class="wrap book-grid">
    <div data-reveal>
      <p class="kicker">Booking</p>
      <h2 class="h2">Pesan jadwal<br>lewat WhatsApp.</h2>
      <ol class="steps">
        <li><span><b>Isi form di samping.</b> Cukup nama dan layanan, sisanya boleh kosong.</span></li>
        <li><span><b>Tekan kirim.</b> WhatsApp terbuka dengan pesan yang sudah tersusun.</span></li>
        <li><span><b>Tunggu balasan.</b> Kami konfirmasi jam yang kosong.</span></li>
      </ol>
      <p class="direct">Lebih suka langsung chat? <a href="https://wa.me/6285728958582" target="_blank" rel="noopener">0857-2895-8582</a></p>
    </div>

    <form class="form" id="form" novalidate data-reveal>
      <div class="field">
        <label for="nama">Nama</label>
        <input class="input" id="nama" name="nama" autocomplete="given-name" placeholder="Nama panggilan juga boleh" required>
      </div>
      <div class="field">
        <span class="label">Mau perawatan apa?</span>
        <div class="chips" id="chips">
          <label class="chip"><input type="checkbox" value="Smoothing"><span>Smoothing</span></label>
