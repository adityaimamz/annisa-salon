---
import Base from '../layouts/Base.astro';
import App from '../kasir/App';
import '../styles/site.css';
import '../styles/kasir.css';
---
<Base title="Kasir · An-Nisa Muslimah Salon" noindex>
  <Fragment slot="head">
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Kasir An-Nisa" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  </Fragment>
  <App client:only="react" />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/kasir' }).catch(() => {});
      });
    }
  </script>
</Base>
