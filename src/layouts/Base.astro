---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  themeColor?: string;
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description,
  ogImage = '/og-image.jpg',
  ogImageAlt = 'Logo An-Nisa Muslimah Salon',
  ogTitle = title,
  ogDescription = description,
  noindex = false,
  themeColor = '#1D4D3A',
  jsonLd,
} = Astro.props;
// WhatsApp/Facebook butuh URL absolut, jadi `site` di astro.config harus terisi saat build.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const ogImageUrl = abs(ogImage);
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    {pageUrl && !noindex && <link rel="canonical" href={pageUrl} />}
    {!noindex && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="An-Nisa Muslimah Salon" />
        <meta property="og:locale" content="id_ID" />
        <meta property="og:title" content={ogTitle} />
        {ogDescription && <meta property="og:description" content={ogDescription} />}
        {pageUrl && <meta property="og:url" content={pageUrl} />}
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="icon" type="image/png" href="/assets/mark.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Onest:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
